# ---- HubSpot (app privado yuca_workflow_actions) ----
HUBSPOT_PRIVATE_APP_TOKEN=pat-xxxxxxxx
HUBSPOT_CLIENT_SECRET=xxxxxxxx        # aba Auth do app privado; valida a assinatura v3

# ---- OpenAI ----
OPENAI_API_KEY=sk-xxxxxxxx
OPENAI_PROMPT_ID=pmpt_xxxxxxxx        # o mesmo prompt salvo que você já usa
OPENAI_PROMPT_VERSION=               # opcional; deixe vazio para usar a versão atual

# ---- Filtro de negócio ----
PIPELINE_N1_ID=0                     # internal id do pipeline N1 (confirmar)
DEPARTAMENTO_ESPERADO=Engenharia     # valor interno da opção do dropdown departamento__n2
STAGE_FECHADO_ID=                    # internal id do stage "Fechado/ Concluído" (confirmar); vazio = não filtra por stage
